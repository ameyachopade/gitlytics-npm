    "sdk"
  ],
  "homepage": "https://gitlytics.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ameyachopade/gitlytics.git"
  },
  "bugs": {
    "url": "https://github.com/ameyachopade/gitlytics/issues"
  }
