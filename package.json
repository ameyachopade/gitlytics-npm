{
  "name": "@gitlytics/cli",
  "version": "0.9.0",
  "description": "Zero-dependency GitHub traffic analytics CLI, JS/TS SDK, dual-mode MCP server, and local dashboard for Gitlytics",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "bin": {
    "gitlytics": "./bin/gitlytics.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "assets/",
    "bin/",
    "src/",
    "types/",
    "static/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test"
  },
  "keywords": [
    "gitlytics",
    "github-traffic",
    "github-analytics",
    "mcp",
    "model-context-protocol",
    "readme-badges",
